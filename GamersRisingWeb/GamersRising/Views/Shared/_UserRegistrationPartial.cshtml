@model GamersRising.Models.RegistrationModel

<!-- Modal -->
<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="registrationDropLabel">Register</h5>
        </div>
        <div class="modal-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div id="alert_placeholder_register">

            </div>
            <form id="UserregistrationForm" asp-controller="UserAuth" asp-action="RegisterUser">
                <input type="hidden" asp-for="RegistrationInValid" />

                <div class="form-group row">
                    <label asp-for="FullName" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="FullName" placeholder="Full Name" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="UserName" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="UserName" placeholder="Username" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Email" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="Email" placeholder="Email Adress" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Password" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="Password" placeholder="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="ConfirmPassword" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="ConfirmPassword" placeholder="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="BirthDate" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="BirthDate" placeholder="Birth Date" class="dateselector form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="PhoneNumber" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="PhoneNumber" placeholder="Phone Number" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                    </div>
                </div>
            </form>

            <p class="text-center">
                By creating an accout you agree to our <a asp-controller="Home" asp-action="Privacy">terms and coditions and privacy policy</a>
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" id="Register" name="Register" class="btn btn-primary">Register</button>
        </div>
    </div>
</div>