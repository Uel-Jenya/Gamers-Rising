@model GamersRising.Models.LoginModel

<!-- Modal -->
<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="loginDropLabel">Login</h5>
        </div>
        <div class="modal-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <form id="UserLoginForm" asp-controller="UserAuth" asp-action="Login">
                <input type="hidden" asp-for="LoginInValid"/>

                <div class="form-group row">
                    <label asp-for="Email" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="Email" placeholder="Email Adress" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Password" class="col-md-4 col-form-label"></label>
                    <div class="col-md-8">
                        <input asp-for="Password" placeholder="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-8 offsetmd-8">
                        <input asp-for="RememberMe"  class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>

                    </div>
                </div>
            </form>

            <p class="text-center">
                By creating an accout you agree to our <a asp-controller="Home" asp-action="Privacy">terms and coditions and privacy policy</a>
            </p>

        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" id="login" name="login" class="btn btn-primary">Login</button>
        </div>
    </div>
</div>